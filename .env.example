# Model — provider-prefixed strings route through LiteLLM, bare names through ADK's Gemini registry.
ADK_MODEL=openai/gpt-5.6-terra

# Credentials (only the one matching ADK_MODEL is required)
OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=0

# Paths
DOCS_DIR=data
OUT_DIR=data/outputs

# Run behaviour
MAX_CONCURRENCY=3
OVERWRITE=True
MAX_ATTEMPTS=5
LOG_LEVEL=INFO
USER_ID=local_user
